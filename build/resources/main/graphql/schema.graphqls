type Query {
    items(categoryId: ID, keyword: String): [Item!]!
    item(id: ID!): Item
    categories: [Category!]!
    sellerItems: [Item!]!
    sellerOrders: [Order!]!
    cart: [CartItem!]!
    buyerOrders: [Order!]!
    order(id: ID!): Order
}

type Mutation {
    createItem(input: ItemInput!): Item!
    updateItem(id: ID!, input: ItemInput!): Item!
    addToCart(itemId: ID!, quantity: Int!): CartItem!
    updateCart(id: ID!, quantity: Int!): CartItem
    removeFromCart(id: ID!): Boolean
    checkout: [Order!]!
    markPaid(orderId: ID!): Order!
    ship(orderId: ID!, trackingNumber: String): Shipment!
    confirmDelivered(orderId: ID!): Order!
}

type Item {
    id: ID!
    name: String!
    description: String
    brand: String
    location: String
    price: Float!
    quantity: Int!
    status: String!
    category: Category
    images: [ItemImage!]!
    thumbnail: String
    sellerId: String!
    createdAt: String!
}

input ItemInput {
    name: String!
    description: String
    brand: String
    location: String
    price: Float!
    quantity: Int!
    categoryId: ID!
}

type ItemImage {
    id: ID!
    data: String!
    sortOrder: Int!
}

type Category {
    id: ID!
    name: String!
    parentId: ID
    children: [Category!]!
}

type CartItem {
    id: ID!
    item: Item!
    quantity: Int!
}

type Order {
    id: ID!
    buyerId: String!
    sellerId: String!
    status: String!
    paymentMethod: String!
    paymentStatus: String!
    totalAmount: Float!
    items: [OrderItem!]!
    shipments: [Shipment!]!
    createdAt: String!
}

type OrderItem {
    itemId: ID!
    name: String!
    quantity: Int!
    unitPrice: Float!
}

type Shipment {
    id: ID!
    status: String!
    trackingNumber: String
    shippedAt: String
}
